# Copy to .env and fill in what you need. Everything has a working default
# except AUTH_SECRET in production.

# --- required in production -------------------------------------------------
# openssl rand -hex 32
AUTH_SECRET=

# --- AI provider ------------------------------------------------------------
# With none of these set, agents run the deterministic offline heuristic
# policy. It exercises the whole platform but is NOT a language model.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, OpenRouter).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- web search -------------------------------------------------------------
# Without this the researcher reports the gap rather than inventing sources.
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=

# --- embeddings -------------------------------------------------------------
# Default is a local hash embedding: deterministic, no API key, but lexical
# rather than semantic. Point at a real model when recall matters.
# EMBEDDINGS_PROVIDER=voyage
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=voyage-3-lite

# --- server -----------------------------------------------------------------
# PORT=4000
# HOST=0.0.0.0
# DATABASE_PATH=./data/sup.db
# LOG_LEVEL=info
# CORS_ORIGINS=https://your-app.example.com
# SERVE_STATIC_DIR=../web/dist

# --- limits (all optional) --------------------------------------------------
# GLOBAL_RUN_CONCURRENCY=12
# RUN_TIMEOUT_MS=300000
# TOOL_TIMEOUT_MS=45000
# AGENT_MESSAGE_RATE=30
# APPROVAL_TTL_MS=900000

# --- deployment -------------------------------------------------------------
# SUP runs as ONE long-lived process: the same Fastify listener serves the REST
# API, the websocket hub and the built client. It needs a container host or a
# VM, not a serverless platform — a function cannot hold the websocket open, and
# the event log's gap-free sequence assumes a single writer.

# Where SQLite lives. Point this at a mounted, persistent volume in production;
# on an ephemeral filesystem the database is empty again after every restart.
# DATA_DIR=/data

# Serve the built client from the API process (the single-origin deployment).
# SERVE_STATIC_DIR=/app/packages/web/dist

# Only needed if the client is hosted somewhere else, e.g. the frontend on a
# CDN and the API on a container host. Comma-separated; defaults to allowing any
# origin, which is fine in dev and wrong in production.
# CORS_ORIGINS=https://sup.example.com

# Build-time setting for the WEB package, not the server. Unset means
# same-origin. Set it when the frontend is deployed separately, and it must be
# the backend's absolute origin (ws/wss is derived from it).
# VITE_API_ORIGIN=https://sup-api.example.com
